{
  "manifest_version": 3,
  "name": "Depurador de Diseños",
  "short_name": "Depurador",
  "version": "0.1.0",
  "description": "Revisa tus diseños antes de mandarlos a producción. Pega una captura y la IA detecta errores.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Abrir Depurador de Diseños", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://depurador-disenarte.vercel.app/*"]
}
